# Example environment variables for Polymarket SDK
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!

# Private key for trading operations
# CRITICAL: Keep this secure! Never share or commit to git
POLYMARKET_PRIVATE_KEY=your_private_key_here

# RPC URL for Polygon network
POLYGON_RPC_URL=https://polygon-rpc.com

# Chain ID (137 for Polygon mainnet, 80002 for Amoy testnet)
CHAIN_ID=137

# API credentials (if needed)
# POLYMARKET_API_KEY=your_api_key_here
# POLYMARKET_API_SECRET=your_api_secret_here
# POLYMARKET_API_PASSPHRASE=your_passphrase_here
